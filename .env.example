# 1. Groq AI API Key (Get a free key from https://console.groq.com/keys)
VITE_GROQ_API_KEY=

# 2. Google Gemini AI API Key (Get a free key from https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=

# 3. Geoapify Places API Key (Get a free key from https://www.geoapify.com/)
VITE_GEOAPIFY_API_KEY=

# 4. (Optional) Google Places / Maps API Key
VITE_GOOGLE_MAPS_API_KEY=

# 5. (Optional) Custom Agency Domain
VITE_DEMO_BASE_DOMAIN=demo.dhanexstudio.com
